{
  "schema_version": "1.0",
  "profile": "team-standard",
  "local_green": {
    "environment": {
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "commands": [
      [".venv-sddgov/bin/sddgov", "doctor", "."],
      [".venv-sddgov/bin/sddgov", "ci", "verify", "."],
      [".venv-sddgov/bin/python", "scripts/readme_command_smoke.py"],
      [".venv-sddgov/bin/python", "scripts/check_release_parity.py"],
      [
        ".venv-sddgov/bin/python",
        "-m",
        "pytest",
        "-q",
        "--ignore=tests/test_subject_progress.py",
        "--ignore=tests/test_subject_task_authorization_dispatch.py",
        "--ignore=tests/test_subject_development_mission_v4.py",
        "--ignore=tests/test_subject_task_authorization_dispatch_v4.py"
      ]
    ]
  },
  "hosted": {
    "max_runs_per_work_package": 1,
    "max_reruns_per_revision": 1,
    "expected_minutes": 20,
    "full_matrix": "manual_or_ready_for_review"
  },
  "workflow_controls": {
    "require_concurrency": true,
    "cancel_in_progress": true,
    "require_job_timeouts": true,
    "require_read_only_permissions": true,
    "skip_draft_pull_requests": true,
    "exempt_workflows": [
      "pages.yml",
      "publish.yml"
    ]
  }
}
