{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sdd-governance.local/schemas/debug-evidence-package.schema.json",
  "title": "Debug Evidence Package",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "dep_id",
    "issue",
    "risk_level",
    "created_at",
    "updated_at",
    "workflow",
    "expected_behavior",
    "actual_behavior",
    "environment",
    "root_cause_status",
    "attachments"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "(?:^|/)schemas/debug-evidence-package\\.schema\\.json$"
    },
    "schema_version": {"const": "1.0"},
    "dep_id": {"type": "string", "pattern": "^DEP-[A-Za-z0-9._-]+$"},
    "issue": {"type": "string", "minLength": 1},
    "sdd_references": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"enum": ["L0", "L1", "L2", "L3"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "workflow": {
      "type": "object",
      "required": ["phase", "history"],
      "properties": {
        "phase": {"enum": ["red", "evidence", "fix", "green", "proof"]},
        "history": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["phase", "at"],
            "properties": {
              "phase": {"enum": ["red", "evidence", "fix", "green", "proof"]},
              "at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"phase": {"const": "red"}}}, "then": {"properties": {"history": {"minItems": 1, "maxItems": 1, "prefixItems": [{"properties": {"phase": {"const": "red"}}}]}}}},
        {"if": {"properties": {"phase": {"const": "evidence"}}}, "then": {"properties": {"history": {"minItems": 2, "maxItems": 2, "prefixItems": [{"properties": {"phase": {"const": "red"}}}, {"properties": {"phase": {"const": "evidence"}}}]}}}},
        {"if": {"properties": {"phase": {"const": "fix"}}}, "then": {"properties": {"history": {"minItems": 3, "maxItems": 3, "prefixItems": [{"properties": {"phase": {"const": "red"}}}, {"properties": {"phase": {"const": "evidence"}}}, {"properties": {"phase": {"const": "fix"}}}]}}}},
        {"if": {"properties": {"phase": {"const": "green"}}}, "then": {"properties": {"history": {"minItems": 4, "maxItems": 4, "prefixItems": [{"properties": {"phase": {"const": "red"}}}, {"properties": {"phase": {"const": "evidence"}}}, {"properties": {"phase": {"const": "fix"}}}, {"properties": {"phase": {"const": "green"}}}]}}}},
        {"if": {"properties": {"phase": {"const": "proof"}}}, "then": {"properties": {"history": {"minItems": 5, "maxItems": 5, "prefixItems": [{"properties": {"phase": {"const": "red"}}}, {"properties": {"phase": {"const": "evidence"}}}, {"properties": {"phase": {"const": "fix"}}}, {"properties": {"phase": {"const": "green"}}}, {"properties": {"phase": {"const": "proof"}}}]}}}}
      ],
      "additionalProperties": false
    },
    "expected_behavior": {"type": "string"},
    "actual_behavior": {"type": "string"},
    "environment": {
      "type": "object",
      "required": ["commit", "branch", "runtime"],
      "properties": {
        "commit": {"type": "string"},
        "branch": {"type": "string"},
        "runtime": {"type": "string"}
      },
      "additionalProperties": true
    },
    "root_cause_status": {"enum": ["unknown", "hypothesized", "confirmed", "rejected"]},
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^shareable/artifacts/(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1F\\x7F]*[^/\\\\\\x00-\\x1F\\x7F .]/)*(?!\\.{1,2}$)[^/\\\\\\x00-\\x1F\\x7F]*[^/\\\\\\x00-\\x1F\\x7F .]$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "collector": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
