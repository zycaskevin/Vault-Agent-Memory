{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Collector Event",
  "type": "object",
  "required": ["collector", "path", "sha256", "collected_at", "shareable"],
  "properties": {
    "collector": {
      "enum": [
        "browser-console", "browser-har", "playwright-trace", "flutter-log",
        "android-logcat", "supabase-log", "docker-log", "terminal", "git"
      ]
    },
    "path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "collected_at": {"type": "string", "format": "date-time"},
    "shareable": {"const": false}
  },
  "additionalProperties": false
}
